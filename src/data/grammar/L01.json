          { "role": "Adv", "label": "副詞", "text": "多", "pinyin": "duō" },
          { "role": "V", "label": "動詞", "text": "关照", "pinyin": "guānzhào" }
        ]
      },
      {
        "id": "EX-G01-01-3",
        "hanzi": "我们欢迎你们来北京。",
        "pinyin": "Wǒmen huānyíng nǐmen lái Běijīng.",
