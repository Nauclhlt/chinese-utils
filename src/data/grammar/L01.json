  {
    "id": "G01-03",
    "title": "動詞述語文の基本語順（S+V+O）",
    "categoryId": "cat-basic",
    "lessonId": "L01",
    "difficulty": 1,
    "prerequisites": ["G01-01"],
    "relatedIds": ["G01-01", "G01-02", "G02-03", "G02-04"],
    "meaning": "動作や行為を表す動詞を述語にした、中国語で最も基本的な文型です。日本語（主語＋目的語＋動詞）と異なり、「主語(S) ＋ 動詞(V) ＋ 目的語(O)」の語順をとります。",
    "pattern": "肯定：S + V + O ／ 否定：S + 不 + V + O",
    "structureSlots": [
      { "role": "S", "label": "主語", "text": "我 / 你们", "pinyin": "wǒ / nǐmen" },
      { "role": "Neg", "label": "否定(任意)", "text": "不", "pinyin": "bù" },
      { "role": "V", "label": "動詞", "text": "叫 / 姓 / 学习 / 喝", "pinyin": "jiào / xìng / xuéxí / hē" },
      { "role": "O", "label": "目的語", "text": "佐藤 / 汉语 / 茶", "pinyin": "Zuǒténg / Hànyǔ / chá" }
    ],
    "wordOrderNote": "日本語の助詞「を」「に」「へ」にあたる言葉は原則として使わず、動詞のすぐ後ろに目的語（対象や到着地）を置きます。否定の副詞「不」は動詞の直前に置きます。",
    "usageConditions": "「叫（〜という名前だ）」「姓（苗字が〜である）」「来（〜へ来る）」「学习（〜を学ぶ）」「喝（〜を飲む）」「欢迎（〜を歓迎する）」など一般動詞が中心になります。",
    "distinctionNotes": "「姓」は後ろに原則として「苗字のみ（1〜2文字）」を取ります（例：我姓山田）。フルネームや下の名前を言うときは「叫」を使います（例：我叫山田太郎）。",
    "forms": {
      "affirmative": "S + V + O",
      "negative": "S + 不 + V + O",
      "interrogative": "S + V + O + 吗？（第2課で詳述）"
