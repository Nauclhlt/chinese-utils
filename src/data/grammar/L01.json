          { "role": "V", "label": "動詞", "text": "叫", "pinyin": "jiào" },
          { "role": "O", "label": "氏名", "text": "王丽", "pinyin": "Wáng Lì" }
        ]
      },
      {
        "id": "EX-G01-01-5",
        "hanzi": "他们都是留学生，谢谢他们。",
        "pinyin": "Tāmen shì liúxuéshēng, xièxie tāmen.",
        "ja": "彼らは留学生です。彼らに感謝します。",
        "note": "「他们」は男女を含む複数の3人称にも使われます。",
        "breakdown": [
          { "role": "S", "label": "主語", "text": "他们", "pinyin": "tāmen" },
          { "role": "V", "label": "判断動詞", "text": "是", "pinyin": "shì" },
          { "role": "O", "label": "目的語", "text": "留学生", "pinyin": "liúxuéshēng" },
          { "role": "V", "label": "動詞", "text": "谢谢", "pinyin": "xièxie" },
          { "role": "O", "label": "目的語", "text": "他们", "pinyin": "tāmen" }
        ]
      }
    ],
    "referenceUrl": "https://hanyujiaocai.jinkan.kyoto-u.ac.jp/2018shanghai/2018CALL/L1_3.html",
    "referenceTitle": "文法事項 １．人称代詞"
