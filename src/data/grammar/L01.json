  {
    "id": "G01-02",
    "title": "“是”と“不是”（判断文）",
    "categoryId": "cat-basic",
    "lessonId": "L01",
    "difficulty": 1,
    "prerequisites": ["G01-01"],
    "relatedIds": ["GP-02", "G01-01", "G01-03", "G02-02"],
    "meaning": "「A は B である」という身分・属性・国籍・職業などのイコール関係を表す基本構文です。否定は「是」の直前に否定副詞「不」を置いて「不是（〜ではない）」とします。",
    "pattern": "肯定：S + 是 + 名詞(句) ／ 否定：S + 不是 + 名詞(句)",
    "structureSlots": [
      { "role": "S", "label": "主語", "text": "我 / 他", "pinyin": "wǒ / tā" },
      { "role": "Neg", "label": "否定(任意)", "text": "不", "pinyin": "bù" },
      { "role": "V", "label": "判断動詞", "text": "是", "pinyin": "shì" },
      { "role": "O", "label": "名詞述語", "text": "日本人 / 留学生", "pinyin": "Rìběnrén / liúxuéshēng" }
    ],
    "wordOrderNote": "中国語では日本語と異なり、述語である「是」が主語と目的語（名詞）の間に置かれます。否定の「不」は必ず「是」の直前に置きます。",
    "usageConditions": "主語と目的語が「同じもの・同じ属性（A = B）」であるときに使います。後ろには原則として名詞や代詞が来ます。",
    "distinctionNotes": "日本語の「〜です」につられて形容詞の前に「是」を置く（×我是高 / ×她是漂亮）のは典型的な誤りです。形容詞が述語になるときは「是」を使いません（第3課で学習）。また、発音上「不是」は後ろの「shì」が第4声なので「bú shì」と第2声＋第4声に変調します。",
    "forms": {
      "affirmative": "S + 是 + O",
      "negative": "S + 不是 + O",
      "interrogative": "S + 是 + O + 吗？（第2課で詳述）"
    },
    "japaneseLearnerPitfalls": [
      "「彼女は親切です／きれいです」のように形容詞を述語にする場面で「×她是好」と「是」を入れてしまう誤り。",
      "「不是」の発音を本来の声調のまま「bù shì」と読んでしまう点（実際は第2声＋第4声の bú shì に変調する）。",
      "「ではない」の語順を誤って「×是不」としてしまう誤り。"
    ],
    "similarDifferences": [
      {
        "targetId": "GP-02",
        "targetName": "声調変調（一・不）",
        "difference": "「不」は単独では第4声（bù）ですが、第4声の「是 (shì)」の前では第2声（bú）に変わります。"
      },
      {
        "targetId": "G01-03",
        "targetName": "動詞述語文の基本語順",
        "difference": "「是」も広義の動詞（判断動詞）であり、S + V + O の語順に従います。"
      }
    ],
    "examples": [
      {
        "id": "EX-G01-02-1",
        "hanzi": "我是日本人。",
        "pinyin": "Wǒ shì Rìběnrén.",
        "ja": "私は日本人です。",
        "note": "国籍を表す基本の肯定判断文。",
        "breakdown": [
          { "role": "S", "label": "主語", "text": "我", "pinyin": "wǒ" },
          { "role": "V", "label": "判断動詞", "text": "是", "pinyin": "shì" },
          { "role": "O", "label": "名詞", "text": "日本人", "pinyin": "Rìběnrén" }
        ]
      },
