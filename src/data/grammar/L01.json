[
  {
    "id": "G01-01",
    "title": "人称代詞",
    "categoryId": "cat-basic",
    "lessonId": "L01",
    "difficulty": 1,
    "prerequisites": [],
    "relatedIds": ["GP-01", "G01-02", "G01-03", "G02-01"],
    "meaning": "「私」「あなた」「彼／彼女」やその複数形など、人や事物を指し示す基本の代詞です。中国語では格変化（主格・目的格などの形の変化）がなく、主語でも目的語でも同じ形を使います。",
    "pattern": "単数：我 / 你 / 您 / 他 / 她 / 它 ｜ 複数：我们 / 咱们 / 你们 / 他们 / 她们",
    "structureSlots": [
      { "role": "S", "label": "1人称", "text": "我 / 我们", "pinyin": "wǒ / wǒmen" },
      { "role": "S", "label": "2人称", "text": "你 / 您 / 你们", "pinyin": "nǐ / nín / nǐmen" },
      { "role": "S", "label": "3人称", "text": "他 / 她 / 他们", "pinyin": "tā / tā / tāmen" }
    ],
    "wordOrderNote": "日本語の「私は／私を／私に」のように助詞を伴って形が変わることはなく、文中の位置（動詞の前＝主語、動詞の後＝目的語）で役割が決まります。",
    "usageConditions": "目上の人や初対面の相手には「你 (nǐ)」の代わりに敬称「您 (nín)」を使います。複数は原則として後ろに軽声の「们 (men)」を付けます。話し手と聞き手の両方を含む「私たち」には「咱们 (zánmen)」も使われます。",
    "distinctionNotes": "「他」「她」「它」はいずれも発音が同じ tā（第1声）です。話し言葉では男女を区別せず、書き言葉の漢字で「彼（他）」「彼女（她）」「それ（它）」を区別します。男女混合の複数形には「他们」を使います。",
    "forms": {
      "affirmative": "我 / 你 / 您 / 他 / 她 + 述語",
      "negative": "主語(人称代詞) + 不 + 述語",
      "interrogative": "主語(人称代詞) + 述語 + 吗？"
    },
    "japaneseLearnerPitfalls": [
      "敬称「您」に「们」を付けて「×您们」と書いてしまう誤り（複数で敬意を表すときは「各位」「大家」や「你们各位」などを使う）。",
      "「たち（们）」を使うべき複数場面で単数のままにしてしまったり、逆に「×三个同学们」のように具体的な人数・数量の後ろに「们」を付けてしまう誤り。",
      "「我」「你」を続けて読むとき（例：「你我」）に、日本語と同じように「我々」感覚で「们」を落としたり変調（第3声＋第3声）を忘れる点。"
    ],
    "similarDifferences": [
      {
        "targetId": "GP-01",
        "targetName": "声調の基本（轻声を含む）",
        "difference": "複数接尾辞「们 (men)」は常に軽声（第5声）で短く軽く発音します。"
      },
      {
        "targetId": "G02-01",
        "targetName": "連体修飾 I “的”",
        "difference": "「私たちの」「彼の」のように所有を表すときは、人称代詞の後ろに「的」を付けて修飾語にします。"
      }
    ],
    "examples": [
      {
        "id": "EX-G01-01-1",
        "hanzi": "我是田中。",
        "pinyin": "Wǒ shì Tiánzhōng.",
        "ja": "私は田中です。",
        "note": "1人称単数「我」を主語にした自己紹介。",
        "breakdown": [
          { "role": "S", "label": "主語", "text": "我", "pinyin": "wǒ" },
          { "role": "V", "label": "判断動詞", "text": "是", "pinyin": "shì" },
          { "role": "O", "label": "目的語", "text": "田中", "pinyin": "Tiánzhōng" }
        ]
      },
      {
        "id": "EX-G01-01-2",
        "hanzi": "您好，请多关照。",
