        "note": "「不是」の発音は bú shì と変調します（表記は本調の bù shì）。",
        "breakdown": [
          { "role": "S", "label": "主語", "text": "他", "pinyin": "tā" },
          { "role": "Neg", "label": "否定", "text": "不", "pinyin": "bù" },
          { "role": "V", "label": "判断動詞", "text": "是", "pinyin": "shì" },
